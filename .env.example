# =============================================================
# SzabiApp – Docker Compose Configuration
# =============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Edit .env with your values
# 3. Run:              docker compose up --build
# =============================================================

# ── Exposed ports (host machine) ─────────────────────────────
FRONTEND_PORT=80        # Frontend accessible at http://localhost:80
BACKEND_PORT=5062       # Backend API accessible at http://localhost:5062
DB_PORT=5432            # PostgreSQL accessible at localhost:5432

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=szabiapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── JWT (CHANGE THIS in production!) ─────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ── Frontend build ────────────────────────────────────────────
# URL the BROWSER uses to reach the backend.
# Must match the host BACKEND_PORT above (or the public proxy URL).
VITE_API_BASE_URL=http://localhost:5062

# ── Public frontend origin (CORS) ────────────────────────────
# The public URL the browser loads the frontend from. This is added to the
# backend's CORS allow-list. When you're behind a reverse proxy (Nginx
# Proxy Manager, Traefik, Cloudflare, etc.) this MUST be the proxied URL,
# not the internal container/host one.
#
# Examples:
#   FRONTEND_ORIGIN=http://localhost                  # local dev
#   FRONTEND_ORIGIN=https://szabiapp.example.com      # behind reverse proxy
FRONTEND_ORIGIN=http://localhost

# ── Reverse proxy ────────────────────────────────────────────
# Set to true when the backend is behind a TLS-terminating reverse proxy
# (Nginx Proxy Manager, Traefik, Cloudflare, etc.). Skips the in-app
# HTTPS redirect that would otherwise cause loops/warnings.
BEHIND_REVERSE_PROXY=false

# ── Demo / presentation mode ─────────────────────────────────
# Set DEMO_MODE=true to populate the database with ~40 mock users
# (1 admin + 4 managers + 35 employees) and realistic leave requests
# on first start. Seeding is idempotent — it only runs when the users
# table is empty, so it's safe to leave on across restarts.
# To reset: set DEMO_MODE=false OR run `docker compose down -v` to
# wipe the postgres_data volume.
DEMO_MODE=false
DEMO_APPLY_MIGRATIONS=true
DEMO_DEFAULT_PASSWORD=Demo123!
DEMO_EMPLOYEE_COUNT=35
DEMO_MANAGER_COUNT=4